# PostgreSQL connection string. `npm run db:dev` starts a local embedded Postgres on this port.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/skillbridge"
PORT=4000
CLIENT_URL="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Optional: enables AI-written match explanations. The app works without it.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Optional: store uploads in S3 instead of server/uploads. Credentials come from the AWS default chain
# (instance role on AWS, `aws configure` locally) - never put keys here.
S3_BUCKET=""
AWS_REGION="ap-south-1"
