# Runs on every deploy, after the bundle is unpacked: install server deps, sync the schema, seed once if empty.
container_commands:
  01_install_server:
    command: "export HOME=/root && cd server && npm ci --omit=dev --no-audit --no-fund && npx prisma generate"
  02_sync_schema:
    command: "export HOME=/root && cd server && npx prisma db push --skip-generate"
    leader_only: true
  03_seed_if_empty:
    command: "export HOME=/root && cd server && node scripts/seed-if-empty.js"
    leader_only: true
